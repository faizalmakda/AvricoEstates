# Copy this file to ".env" and fill in the two values from your Supabase project.
# Supabase dashboard -> Project Settings -> API
#
# These are SAFE to expose in a browser app (they are the public "anon" key).
# The database is protected by Row Level Security policies, not by hiding this key.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here
